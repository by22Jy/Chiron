{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-filesystem", "d:/yolo-llm"],
      "description": "文件系统操作工具",
      "env": {}
    },
    "email": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-email"],
      "description": "邮件收发工具",
      "env": {
        "SMTP_HOST": "smtp.gmail.com",
        "SMTP_PORT": "587",
        "IMAP_HOST": "imap.gmail.com",
        "IMAP_PORT": "993"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-playwright"],
      "description": "浏览器自动化工具",
      "env": {}
    },
    "puppeteer": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-puppeteer"],
      "description": "Chrome浏览器自动化工具",
      "env": {}
    },
    "weather": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-weather"],
      "description": "天气查询工具",
      "env": {
        "WEATHER_API_KEY": "your-openweather-api-key"
      }
    },
    "brave-search": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-brave-search"],
      "description": "网络搜索工具",
      "env": {
        "BRAVE_API_KEY": "your-brave-search-api-key"
      }
    },
    "github": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-github"],
      "description": "GitHub集成工具",
      "env": {
        "GITHUB_TOKEN": "your-github-token"
      }
    },
    "slack": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-slack"],
      "description": "Slack集成工具",
      "env": {
        "SLACK_TOKEN": "your-slack-token"
      }
    },
    "git": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-git"],
      "description": "Git版本控制工具",
      "env": {}
    },
    "memory": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-memory"],
      "description": "持久化内存存储工具",
      "env": {}
    },
    "postgres": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-postgres"],
      "description": "PostgreSQL数据库工具",
      "env": {
        "POSTGRES_URL": "postgresql://user:password@localhost:5432/dbname"
      }
    },
    "sqlite": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-sqlite"],
      "description": "SQLite数据库工具",
      "env": {
        "SQLITE_DB": "d:/yolo-llm/database.db"
      }
    }
  }
}