"""
MCP HTTP服务器
为Java Backend提供MCP工具的HTTP接口
"""

import asyncio
import json
import os
import sys
from datetime import datetime
from typing import Dict, Any, List
from pathlib import Path

# 添加父目录到路径
sys.path.insert(0, str(Path(__file__).parent.parent))

from fastapi import FastAPI, HTTPException, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from pydantic import BaseModel
import uvicorn

# 导入已有的服务
from agent.real_news_weather import RealNewsService, RealWeatherService, NewsConfig, WeatherConfig
from agent.email_client import EmailClient, EmailConfig, EmailMessage

app = FastAPI(
    title="YOLO-LLM MCP HTTP Server",
    description="为Java Backend提供MCP工具的HTTP接口",
    version="1.0.0"
)

# 配置CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# 全局服务实例
news_service = None
weather_service = None
email_client = None

class ToolRequest(BaseModel):
    action: str = "execute"
    parameters: Dict[str, Any] = {}
    context: Dict[str, Any] = {}

class WorkflowRequest(BaseModel):
    workflow_name: str
    context: Dict[str, Any] = {}

@app.on_event("startup")
async def startup_event():
    """启动时初始化服务"""
    global news_service, weather_service, email_client

    print("初始化MCP HTTP服务器...")

    # 初始化新闻服务
    try:
        news_config = NewsConfig()
        news_service = RealNewsService(news_config)
        print("新闻服务初始化完成")
    except Exception as e:
        print(f"新闻服务初始化失败: {e}")
        news_service = None

    # 初始化天气服务
    try:
        weather_config = WeatherConfig()
        weather_service = RealWeatherService(weather_config)
        print("天气服务初始化完成")
    except Exception as e:
        print(f"天气服务初始化失败: {e}")
        weather_service = None

    # 初始化邮件客户端
    try:
        email_config = EmailConfig()
        email_client = EmailClient(email_config)
        print("邮件客户端初始化完成")
    except Exception as e:
        print(f"邮件客户端初始化失败: {e}")
        email_client = None

    print("MCP HTTP服务器启动完成!")

@app.get("/health")
async def health_check():
    """健康检查"""
    return {
        "status": "healthy",
        "timestamp": datetime.now().isoformat(),
        "services": {
            "news": news_service is not None,
            "weather": weather_service is not None,
            "email": email_client is not None
        },
        "available_tools": [
            "news", "weather", "email", "filesystem", "screenshot", "browser"
        ]
    }

@app.get("/tools")
async def get_available_tools():
    """获取可用工具列表"""
    return {
        "success": True,
        "tools": [
            {
                "name": "news",
                "description": "获取新闻信息",
                "parameters": ["count", "category", "country"]
            },
            {
                "name": "weather",
                "description": "获取天气信息",
                "parameters": ["city", "units", "lang"]
            },
            {
                "name": "email",
                "description": "发送邮件",
                "parameters": ["to", "subject", "content", "attachments"]
            },
            {
                "name": "filesystem",
                "description": "文件系统操作",
                "parameters": ["operation", "path", "content"]
            },
            {
                "name": "screenshot",
                "description": "截图操作",
                "parameters": ["region", "save_path"]
            },
            {
                "name": "browser",
                "description": "浏览器自动化",
                "parameters": ["action", "url", "selectors"]
            }
        ]
    }

@app.post("/mcp/{tool_name}")
async def call_mcp_tool(tool_name: str, request: ToolRequest):
    """调用指定的MCP工具"""
    try:
        print(f"[INFO] 调用MCP工具: {tool_name}")

        if tool_name == "news":
            return await handle_news_tool(request)
        elif tool_name == "weather":
            return await handle_weather_tool(request)
        elif tool_name == "email":
            return await handle_email_tool(request)
        elif tool_name == "filesystem":
            return await handle_filesystem_tool(request)
        elif tool_name == "screenshot":
            return await handle_screenshot_tool(request)
        elif tool_name == "browser":
            return await handle_browser_tool(request)
        else:
            raise HTTPException(status_code=404, detail=f"未知的工具: {tool_name}")

    except Exception as e:
        print(f"[ERROR] 工具调用失败: {tool_name}, 错误: {str(e)}")
        return {
            "success": False,
            "error": str(e),
            "tool": tool_name,
            "timestamp": datetime.now().isoformat()
        }

async def handle_news_tool(request: ToolRequest) -> Dict[str, Any]:
    """处理新闻工具"""
    try:
        count = request.parameters.get("count", 10)
        news_list = news_service.fetch_top_headlines(count)

        return {
            "success": True,
            "tool": "news",
            "data": {
                "news": news_list,
                "count": len(news_list),
                "source": "NewsAPI"
            },
            "timestamp": datetime.now().isoformat()
        }
    except Exception as e:
        return {
            "success": False,
            "tool": "news",
            "error": str(e),
            "timestamp": datetime.now().isoformat()
        }

async def handle_weather_tool(request: ToolRequest) -> Dict[str, Any]:
    """处理天气工具"""
    try:
        city = request.parameters.get("city", "北京")
        weather_info = weather_service.fetch_current_weather(city)

        return {
            "success": True,
            "tool": "weather",
            "data": {
                "weather": weather_info,
                "city": city
            },
            "timestamp": datetime.now().isoformat()
        }
    except Exception as e:
        return {
            "success": False,
            "tool": "weather",
            "error": str(e),
            "timestamp": datetime.now().isoformat()
        }

async def handle_email_tool(request: ToolRequest) -> Dict[str, Any]:
    """处理邮件工具"""
    try:
        to_email = request.parameters.get("to_email")
        subject = request.parameters.get("subject")
        body = request.parameters.get("body")

        if not all([to_email, subject, body]):
            raise ValueError("缺少必需参数: to_email, subject, body")

        # 创建邮件消息
        email_message = EmailMessage(
            to_email=to_email,
            subject=subject,
            body=body
        )

        # 发送邮件
        success, message = email_client.send_email(email_message)

        return {
            "success": success,
            "tool": "email",
            "data": {
                "to_email": to_email,
                "subject": subject,
                "message": message
            },
            "timestamp": datetime.now().isoformat()
        }
    except Exception as e:
        return {
            "success": False,
            "tool": "email",
            "error": str(e),
            "timestamp": datetime.now().isoformat()
        }

async def handle_filesystem_tool(request: ToolRequest) -> Dict[str, Any]:
    """处理文件系统工具"""
    try:
        operation = request.parameters.get("operation", "read")
        path = request.parameters.get("path")
        content = request.parameters.get("content", "")

        if operation == "read" and path:
            # 读取文件
            with open(path, 'r', encoding='utf-8') as f:
                file_content = f.read()
            return {
                "success": True,
                "tool": "filesystem",
                "data": {
                    "operation": operation,
                    "path": path,
                    "content": file_content
                },
                "timestamp": datetime.now().isoformat()
            }
        elif operation == "write" and path and content:
            # 写入文件
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, 'w', encoding='utf-8') as f:
                f.write(content)
            return {
                "success": True,
                "tool": "filesystem",
                "data": {
                    "operation": operation,
                    "path": path,
                    "content_length": len(content)
                },
                "timestamp": datetime.now().isoformat()
            }
        else:
            raise ValueError("无效的文件操作或缺少参数")
    except Exception as e:
        return {
            "success": False,
            "tool": "filesystem",
            "error": str(e),
            "timestamp": datetime.now().isoformat()
        }

async def handle_screenshot_tool(request: ToolRequest) -> Dict[str, Any]:
    """处理截图工具"""
    try:
        save_path = request.parameters.get("save_path", f"screenshot_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png")

        try:
            import pyautogui
            screenshot = pyautogui.screenshot()
            screenshot.save(save_path)

            return {
                "success": True,
                "tool": "screenshot",
                "data": {
                    "path": save_path,
                    "size": screenshot.size,
                    "file_size": os.path.getsize(save_path)
                },
                "timestamp": datetime.now().isoformat()
            }
        except ImportError:
            return {
                "success": False,
                "tool": "screenshot",
                "error": "需要安装pyautogui: pip install pyautogui",
                "timestamp": datetime.now().isoformat()
            }
    except Exception as e:
        return {
            "success": False,
            "tool": "screenshot",
            "error": str(e),
            "timestamp": datetime.now().isoformat()
        }

async def handle_browser_tool(request: ToolRequest) -> Dict[str, Any]:
    """处理浏览器工具"""
    try:
        action = request.parameters.get("action", "open")
        url = request.parameters.get("url", "https://www.google.com")

        if action == "open":
            import webbrowser
            webbrowser.open(url)
            return {
                "success": True,
                "tool": "browser",
                "data": {
                    "action": action,
                    "url": url
                },
                "timestamp": datetime.now().isoformat()
            }
        else:
            raise ValueError(f"不支持的浏览器操作: {action}")
    except Exception as e:
        return {
            "success": False,
            "tool": "browser",
            "error": str(e),
            "timestamp": datetime.now().isoformat()
        }

@app.post("/workflow/execute")
async def execute_workflow(request: WorkflowRequest):
    """执行完整工作流"""
    try:
        workflow_name = request.workflow_name
        context = request.context

        print(f"📋 执行工作流: {workflow_name}")

        if workflow_name == "news_weather_email":
            return await execute_news_weather_email_workflow(context)
        elif workflow_name == "get_weather":
            return await execute_get_weather_workflow(context)
        elif workflow_name == "send_email":
            return await execute_send_email_workflow(context)
        else:
            raise HTTPException(status_code=404, detail=f"未知的工作流: {workflow_name}")

    except Exception as e:
        print(f"❌ 工作流执行失败: {workflow_name}, 错误: {str(e)}")
        return {
            "success": False,
            "workflow": workflow_name,
            "error": str(e),
            "timestamp": datetime.now().isoformat()
        }

async def execute_news_weather_email_workflow(context: Dict[str, Any]) -> Dict[str, Any]:
    """执行新闻天气邮件工作流"""
    try:
        email = context.get("email", "1730495747@qq.com")
        city = context.get("city", "北京")

        print(f"📧 执行新闻天气邮件工作流: 邮箱={email}, 城市={city}")

        # 1. 获取新闻
        news_list = news_service.fetch_top_headlines(10)

        # 2. 获取天气
        weather_info = weather_service.fetch_current_weather(city)

        # 3. 构建邮件内容
        email_content = f"""
新闻天气报告 ({datetime.now().strftime('%Y-%m-%d %H:%M:%S')})

📰 头条新闻 (前10条):
{chr(10).join([f'{i+1}. {news}' for i, news in enumerate(news_list[:10])])}

🌤️ 天气信息:
城市: {weather_info.get('city', city)}
温度: {weather_info.get('temperature', 'N/A')}
天气: {weather_info.get('condition', 'N/A')}
湿度: {weather_info.get('humidity', 'N/A')}

此邮件由YOLO-LLM智能代理系统自动生成
"""

        # 4. 发送邮件
        email_message = EmailMessage(
            to_email=email,
            subject=f"YOLO-LLM新闻天气报告 - {datetime.now().strftime('%Y-%m-%d')}",
            body=email_content
        )

        success, message = email_client.send_email(email_message)

        return {
            "success": success,
            "workflow": "news_weather_email",
            "data": {
                "email": email,
                "city": city,
                "news_count": len(news_list),
                "weather": weather_info,
                "email_sent": success,
                "message": message
            },
            "timestamp": datetime.now().isoformat()
        }

    except Exception as e:
        return {
            "success": False,
            "workflow": "news_weather_email",
            "error": str(e),
            "timestamp": datetime.now().isoformat()
        }

async def execute_get_weather_workflow(context: Dict[str, Any]) -> Dict[str, Any]:
    """执行获取天气工作流"""
    try:
        city = context.get("city", "北京")
        weather_info = weather_service.fetch_current_weather(city)

        return {
            "success": True,
            "workflow": "get_weather",
            "data": {
                "city": city,
                "weather": weather_info
            },
            "timestamp": datetime.now().isoformat()
        }
    except Exception as e:
        return {
            "success": False,
            "workflow": "get_weather",
            "error": str(e),
            "timestamp": datetime.now().isoformat()
        }

async def execute_send_email_workflow(context: Dict[str, Any]) -> Dict[str, Any]:
    """执行发送邮件工作流"""
    try:
        to_email = context.get("to_email")
        subject = context.get("subject")
        body = context.get("body")

        if not all([to_email, subject, body]):
            raise ValueError("缺少必需参数: to_email, subject, body")

        email_message = EmailMessage(
            to_email=to_email,
            subject=subject,
            body=body
        )

        success, message = email_client.send_email(email_message)

        return {
            "success": success,
            "workflow": "send_email",
            "data": {
                "to_email": to_email,
                "subject": subject,
                "message": message
            },
            "timestamp": datetime.now().isoformat()
        }
    except Exception as e:
        return {
            "success": False,
            "workflow": "send_email",
            "error": str(e),
            "timestamp": datetime.now().isoformat()
        }

if __name__ == "__main__":
    print("启动YOLO-LLM MCP HTTP服务器...")

    # 检查环境变量
    if not os.getenv("NEWS_API_KEY"):
        print("警告: NEWS_API_KEY 环境变量未设置，新闻功能可能不可用")

    if not os.getenv("WEATHER_API_KEY"):
        print("警告: WEATHER_API_KEY 环境变量未设置，天气功能可能不可用")

    # 启动服务器
    uvicorn.run(
        "mcp_http_server:app",
        host="127.0.0.1",
        port=8081,
        reload=True,
        log_level="info"
    )